{
  "cli": {
    "version": ">= 24.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "12.3.4"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  }
}
